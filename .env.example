VITE_ANKR_API_KEY=your_ankr_api_key_here

# Optional per-chain overrides. Leave blank to use Ankr defaults from src/config.js.
VITE_ETH_RPC=
VITE_ARB_RPC=
VITE_POLY_RPC=
VITE_BASE_RPC=

# Flash-loan planning is fail-closed until these are configured.
VITE_FLASH_LOAN_RECEIVER=
VITE_FLASH_LOAN_REFERRAL_CODE=0
VITE_FLASH_LOAN_PREMIUM_BPS=9
VITE_FLASH_LOAN_MIN_NET_PROFIT_BPS=25
VITE_FLASH_LOAN_MAX_SLIPPAGE_BPS=30
VITE_FLASH_LOAN_GAS_LIMIT=650000
VITE_AAVE_V3_POOL_ETH=
VITE_AAVE_V3_POOL_ARB=
VITE_AAVE_V3_POOL_POLY=
VITE_AAVE_V3_POOL_BASE=
